#!/usr/bin/env python3
import argparse
import subprocess


def main() -> None:
    parser = argparse.ArgumentParser(description="Delete an ephemeral dev application secret")
    parser.add_argument("--target", default="sql-playzone/sql-2026-s2-dev/application")
    parser.add_argument("--profile", default="hyu-ddps")
    parser.add_argument("--region", default="ap-northeast-2")
    arguments = parser.parse_args()
    if not arguments.target.startswith("sql-playzone/") or "-dev/application" not in arguments.target:
        raise SystemExit("The target must be a sql-playzone dev application secret")
    subprocess.run(
        [
            "aws",
            "secretsmanager",
            "delete-secret",
            "--secret-id",
            arguments.target,
            "--force-delete-without-recovery",
            "--profile",
            arguments.profile,
            "--region",
            arguments.region,
        ],
        check=True,
    )


if __name__ == "__main__":
    main()
