#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import secrets
import subprocess
import tempfile


def aws(arguments: list[str], profile: str, region: str) -> dict:
    command = ["aws", *arguments, "--profile", profile, "--region", region, "--output", "json"]
    result = subprocess.run(command, text=True, capture_output=True)
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip())
    return json.loads(result.stdout)


def main() -> None:
    parser = argparse.ArgumentParser(description="Create an ephemeral dev application secret")
    parser.add_argument("--source", default="sql-playzone/sql-2026-s2/application")
    parser.add_argument("--target", default="sql-playzone/sql-2026-s2-dev/application")
    parser.add_argument("--profile", default="hyu-ddps")
    parser.add_argument("--region", default="ap-northeast-2")
    arguments = parser.parse_args()
    if not arguments.target.startswith("sql-playzone/") or "-dev/application" not in arguments.target:
        raise RuntimeError("The target must be a sql-playzone dev application secret")

    source = aws(
        ["secretsmanager", "get-secret-value", "--secret-id", arguments.source],
        arguments.profile,
        arguments.region,
    )
    values = json.loads(source["SecretString"])
    for key in ("GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"):
        if not values.get(key):
            raise RuntimeError(f"Source secret is missing {key}")
    dev_values = {
        "CTFD_SECRET_KEY": secrets.token_hex(32),
        "GOOGLE_CLIENT_ID": values["GOOGLE_CLIENT_ID"],
        "GOOGLE_CLIENT_SECRET": values["GOOGLE_CLIENT_SECRET"],
    }

    file_descriptor, path = tempfile.mkstemp(prefix="sql-playzone-dev-secret-")
    try:
        os.fchmod(file_descriptor, 0o600)
        with os.fdopen(file_descriptor, "w") as secret_file:
            json.dump(dev_values, secret_file, separators=(",", ":"))
        aws(
            [
                "secretsmanager",
                "create-secret",
                "--name",
                arguments.target,
                "--secret-string",
                f"file://{path}",
                "--tags",
                "Key=Project,Value=sql-playzone",
                "Key=Lifecycle,Value=ephemeral",
            ],
            arguments.profile,
            arguments.region,
        )
    finally:
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
    print(f"Created {arguments.target}")


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, json.JSONDecodeError) as error:
        raise SystemExit(str(error)) from error
